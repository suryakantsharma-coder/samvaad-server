# =============================================================================
# SAMVAAD AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all Required values before starting.
# Lines marked [Required] must be set. Lines marked [Optional] have defaults
# shown in square brackets or can be left blank.
#
# IMPORTANT (Production / PM2):
#   PM2 injects its own env at startup and does NOT re-read .env on restart.
#   To update a value in production:
#     pm2 delete <process-name>
#     pm2 start ecosystem.config.cjs --only <process-name>
# =============================================================================


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
NODE_ENV=production                      # development | production
PORT=3000                                # [Optional] API HTTP port (default: 3000)
TZ=Asia/Kolkata                          # [Optional] Server timezone (default: Asia/Kolkata)


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority


# -----------------------------------------------------------------------------
# REDIS  (BullMQ job queues — medicine reminders + appointment confirmations)
# Set REDIS_URL (takes priority) OR individual HOST/PORT/PASSWORD.
# -----------------------------------------------------------------------------
REDIS_URL=                               # e.g. redis://:password@127.0.0.1:6379  (leave blank to use HOST/PORT below)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=                          # [Optional] leave blank if no auth


# -----------------------------------------------------------------------------
# AUTHENTICATION  (JWT)
# IMPORTANT: Change both secrets in production — defaults are insecure.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-in-production-access
JWT_REFRESH_SECRET=change-me-in-production-refresh
JWT_ACCESS_EXPIRY=15m                    # [Optional] default: 15m
JWT_REFRESH_EXPIRY=7d                    # [Optional] default: 7d
JWT_PASSWORD_RESET_SECRET=               # [Optional] falls back to JWT_ACCESS_SECRET


# -----------------------------------------------------------------------------
# PUBLIC URLS  (used in emails, OAuth callbacks, WhatsApp links)
# -----------------------------------------------------------------------------
API_PUBLIC_URL=https://api.yourdomain.com           # No trailing slash
DASHBOARD_URL=https://dashboard.yourdomain.com      # No trailing slash
FRONTEND_GOOGLE_OAUTH_RETURN_URL=https://dashboard.yourdomain.com/settings/integrations
UPLOADS_CORS_ORIGINS=https://dashboard.yourdomain.com   # Comma-separated origins allowed for /uploads/*


# -----------------------------------------------------------------------------
# LIVEKIT  (WebRTC / SIP voice infrastructure)
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [Optional] Agent names (must match names used in LiveKit project / ecosystem config)
AGENT_NAME=hospital-agent
PHONE_AGENT_NAME=hospital-agent
QUEUE_AGENT_NAME=queue-agent

# [Optional] Noise cancellation (set to 1 to enable Krisp/low-latency NC)
LIVEKIT_INPUT_NOISE_CANCELLATION=0
LIVEKIT_INPUT_NC_WITH_LOW_LATENCY=0
LOW_LATENCY_AUDIO=0

# [Optional] Enable phone hold queue (plays music while agent connects)
LIVEKIT_QUEUE_ENABLED=1


# -----------------------------------------------------------------------------
# OPENAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# [Optional] Override default model IDs
OPENAI_REALTIME_MODEL=gpt-realtime-mini-2025-12-15
OPENAI_LLM_MODEL=gpt-4.1
OPENAI_LLM_TEMPERATURE=0.2
EXTRACTION_MODEL=gpt-4.1                 # Model used for post-call data extraction


# -----------------------------------------------------------------------------
# SARVAM AI  (Hindi/English STT + TTS)
# Leave blank to fall back to OpenAI STT/TTS.
# -----------------------------------------------------------------------------
SARVAM_API_KEY=

# STT settings
SARVAM_STT_STREAMING=0                  # IMPORTANT: keep 0 — streaming WS rejects saaras:v3 model
SARVAM_STT_MODEL=saaras:v3              # [Optional]
SARVAM_STT_MODE=                        # [Optional]
SARVAM_LANGUAGE_CODE=hi-IN              # [Optional] default: hi-IN
SARVAM_STT_DEBUG=0                      # [Optional] 1 = verbose STT logging

# TTS settings
SARVAM_TTS_MODEL=bulbul:v1              # [Optional]
SARVAM_TTS_SPEAKER=meera               # [Optional] voice name
SARVAM_TTS_LANGUAGE=hi-IN              # [Optional]
SARVAM_TTS_SAMPLE_RATE=16000           # [Optional]
SARVAM_TTS_LOUDNESS=1.5                # [Optional]
SARVAM_TTS_GAIN=0                      # [Optional]
SARVAM_TTS_MAX_CHUNK=500               # [Optional] max chars per TTS chunk
SARVAM_TTS_MIN_BUFFER=50               # [Optional]
SARVAM_TTS_DEBUG=0                     # [Optional] 1 = verbose TTS logging


# -----------------------------------------------------------------------------
# WHATSAPP — Meta Cloud API
# Obtain from Meta Business Suite → WhatsApp → API Setup
# -----------------------------------------------------------------------------
WHATSAPP_CLOUD_ACCESS_TOKEN=           # Meta permanent / long-lived access token
WHATSAPP_CLOUD_PHONE_NUMBER_ID=        # Meta phone number ID (from API Setup page)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=         # Any secret string; must match Meta webhook config

# [Optional] WhatsApp Cloud API version (default: v21.0)
WHATSAPP_CLOUD_API_VERSION=v21.0

# Appointment confirmation template
APPOINTMENT_TEMPLATE_NAME=             # Approved template name
APPOINTMENT_TEMPLATE_LANG=en_US        # [Optional] default: en_US
APPOINTMENT_TEMPLATE_PARAM_FORMAT=named  # named | positional — must match Meta template creation

# Prescription notification template
PRESCRIPTION_TEMPLATE_NAME=           # Approved template name
PRESCRIPTION_TEMPLATE_LANG=en_US

# Medicine reminder template
MEDICINE_TEMPLATE_NAME=               # Approved template name
MEDICINE_TEMPLATE_LANG=en_US

# Dosage completion + follow-up templates (medicine reminder end-of-course)
DOSAGE_COMPLETION_TEMPLATE_NAME=
DOSAGE_COMPLETION_TEMPLATE_LANG=en_US
DOSAGE_FOLLOWUP_NOT_YET_TEMPLATE_NAME=
DOSAGE_FOLLOWUP_NOT_YET_TEMPLATE_LANG=en_US

# [Optional] URLs embedded inside WhatsApp template messages
WHATSAPP_APPOINTMENT_LINK_URL=         # Patient portal appointment link (falls back to appointmentId)
WHATSAPP_PATIENT_PORTAL_URL=           # Patient portal home URL
WHATSAPP_PRESCRIPTION_URL_BASE=        # Base URL for prescription links: <base>/<prescriptionId>
WHATSAPP_PRESCRIPTION_LINK_TEMPLATE=   # Alternative: URL template with {id} placeholder

# [Optional] Meta app credentials (required only for WhatsApp Business onboarding flow)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# [Optional] WhatsApp chat agent: default hospital when no DB row matches webhook phone_number_id
WHATSAPP_CHAT_DEFAULT_HOSPITAL_ID=
WHATSAPP_CHAT_OPENAI_MODEL=gpt-4.1    # Model for WhatsApp chat replies


# -----------------------------------------------------------------------------
# PHONE HOLD QUEUE  (plays hold music while voice agent prepares)
# Only used when LIVEKIT_QUEUE_ENABLED=1
# -----------------------------------------------------------------------------
QUEUE_HOSPITAL_NAME=                   # Spoken in hold message: "Thank you for calling <name>"
QUEUE_MAX_CONCURRENT_CALLS=5           # [Optional] max simultaneous calls in queue
QUEUE_HOLD_AUDIO_ENABLED=1            # [Optional] 0 = silence instead of music
QUEUE_HOLD_AUDIO_FILE=                 # [Optional] path to .wav/.mp3 hold music file
QUEUE_HOLD_AUDIO_VOLUME=0.5           # [Optional] 0.0–1.0
QUEUE_TTS_MODEL=gpt-4o-mini-tts       # [Optional] TTS model for queue messages
QUEUE_TTS_VOICE=alloy                  # [Optional] TTS voice
QUEUE_TTS_INSTRUCTIONS=               # [Optional] Custom TTS system prompt for queue messages
QUEUE_STALE_SLOT_SWEEP_MS=30000       # [Optional] ms between stale-slot cleanup sweeps


# -----------------------------------------------------------------------------
# MEDICINE REMINDERS  (BullMQ scheduler — runs in reminder worker process)
# -----------------------------------------------------------------------------
REMINDER_SYSTEM_ENABLED=1             # [Optional] 0 to disable all reminders globally
REMINDER_TIMEZONE=Asia/Kolkata        # [Optional] IANA timezone for meal window times
BREAKFAST_TIME=08:00-09:00            # [Optional] Reminder window HH:MM-HH:MM
LUNCH_TIME=13:00-14:00
DINNER_TIME=20:00-21:00
REMINDER_WORKER_CONCURRENCY=5         # [Optional] concurrent BullMQ reminder jobs
APPT_CONFIRM_WORKER_CONCURRENCY=5    # [Optional] concurrent appointment confirmation jobs
REMINDER_WORKER_DISABLED=            # Set to 1 to run reminders as a separate PM2 process
REMINDER_TEST_MODE=                   # Set to 1 for accelerated schedule (dev only)


# -----------------------------------------------------------------------------
# GOOGLE CALENDAR  (video appointments + Google Meet links)
# GCP Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Enable: Google Calendar API, Google Meet API
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/public/google-auth/callback
GOOGLE_CALENDAR_ID=primary             # [Optional] calendar id or "primary"
GOOGLE_OAUTH_STATE_SECRET=             # [Optional] HMAC secret for OAuth state; falls back to JWT_ACCESS_SECRET


# -----------------------------------------------------------------------------
# RAZORPAY  (payment collection)
# Dashboard → Account & Settings → API Keys
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=               # Webhook → Secret (used to verify HMAC signature)


# -----------------------------------------------------------------------------
# MAILTRAP  (transactional email — password reset, welcome)
# mailtrap.io → Sending → API Tokens
# -----------------------------------------------------------------------------
MAILTRAP_API_KEY=                      # Bearer token (without "Bearer " prefix)
MAIL_FROM=Samvaad AI <noreply@yourdomain.com>


# -----------------------------------------------------------------------------
# EXOTEL  (SIP telephony + monthly call analytics sync)
# console.exotel.com → Settings → API
# -----------------------------------------------------------------------------
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_REGION=in                       # [Optional] in | us (default: in)
EXOTEL_SIP_DOMAIN=                     # [Optional] custom SIP domain (e.g. exotel.in)


# -----------------------------------------------------------------------------
# AGENT BEHAVIOUR  (fine-tuning — all optional)
# -----------------------------------------------------------------------------
AVG_PATIENT_CHECKUP_DURATION=15        # Slot duration in minutes used by booking agent
AGENT_COMPACT_HOSPITAL_PROMPT=0        # 1 = shorter system prompt (faster, less context)
AGENT_SKIP_POSTCALL_IF_BOOKED=0        # 1 = skip GPT-4 extraction when appointment was booked
AGENT_VERBOSE_CONNECTION_LOGS=         # 1 = detailed agent startup logs (auto-on in dev)
USE_SAMVAAD_VOICE_LLM=0               # 1 = use custom Samvaad LLM instead of OpenAI
STORAGE_ENGLISH_MODEL=                 # Override for English-only transcription model
TRANSCRIPT_TRANSLATE_MODEL=            # Model used to translate transcripts

# Tele-caller booking link (patient ObjectId appended as last path segment)
TELECALLER_BOOKING_LINK=https://dashboard.yourdomain.com/telecaller/book


# -----------------------------------------------------------------------------
# PAYOUT / CRON  (all optional — leave unset for production defaults)
# -----------------------------------------------------------------------------
HOURLY_PAYOUT_CRON_DISABLED=          # Set to 1 to stop hourly payout aggregation cron
EXOTEL_MONTHLY_SYNC_CRON_DISABLED=    # Set to 1 to stop monthly Exotel sync cron
PAYOUT_CRON_USE_CURRENT_MONTH=        # Set to 1 to aggregate current month (dev only; default: previous month)


# -----------------------------------------------------------------------------
# CLOUDFLARE TUNNEL  (optional — only if using Cloudflare for public URL)
# -----------------------------------------------------------------------------
CLOUDFLARE_DOMAIN=                     # e.g. api.yourdomain.com
CLOUDFLARE_TUNNEL_NAME=                # Tunnel name in Cloudflare dashboard
