# LiveKit (required) – same as backend; copy from ../backend/.env or set here
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_key
LIVEKIT_API_SECRET=your_secret

# Sarvam AI (required) – for LLM, STT, TTS in the Neha voice agent
SARVAM_API_KEY=your_sarvam_key
ENABLE_NOISE_CANCELLATION=false
ENABLE_SILERO_VAD=false

# Optional – set to "true" to enable (can cause native crashes on some systems; leave unset or false)
# ENABLE_NOISE_CANCELLATION=true
# ENABLE_SILERO_VAD=true
